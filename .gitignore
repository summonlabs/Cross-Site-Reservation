CTestTestfile.cmake
Testing/
*.cmake.user
install_manifest.txt
compile_commands.json
.ninja_deps
.ninja_log
*.ninja
Makefile
CMakeUserPresets.json
_deps/

# Visual Studio and compiler output
*.sln
*.vcxproj
*.vcxproj.user
*.vcxproj.filters
.vs/
*.pdb
*.ilk
*.idb
*.exp
*.lib
*.obj
