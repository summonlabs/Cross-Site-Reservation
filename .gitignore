# Editor and operating system noise
.vscode/
.idea/
*~
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Runtime state written by tests
xsr-state/
*.xsrlog
*.xsrsnap
*.tmp

# Crash dumps. The root-only "/core" form matters: an unanchored "core" also
# matches source directories such as src/core.
*.dmp
/core
core.[0-9]*

# Tracked by design. These negations keep an artifact pattern above
# (for example core.*) from ever capturing source or documentation.
!.github/
!CMakeLists.txt
!*.cpp
!*.cc
!*.cxx
!*.hpp
!*.hh
!*.hxx
!*.h
!*.md
!LICENSE
!NOTICE
!README.md
!CONTRIBUTING.md
!docs/
!tests/
!benchmarks/
